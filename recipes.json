[
  {
    "id": "recipe-1",
    "name": "可乐鸡翅",
    "category": "家常菜",
    "description": "经典的家常美味，可乐的甜味与鸡翅的鲜嫩完美结合，大人小孩都爱吃！",
    "coverImage": "https://images.unsplash.com/photo-1598515214211-89d3c73ae83b?w=600&h=400&fit=crop",
    "cookingSteps": "1. 鸡翅洗净，正反面各划两刀，方便入味\n2. 冷水下锅，加入姜片和料酒焯水，捞出沥干\n3. 锅中倒油，放入鸡翅煎至两面金黄\n4. 加入生抽、老抽、姜片翻炒上色\n5. 倒入可乐没过鸡翅，大火烧开后转小火炖15分钟\n6. 开大火收汁，撒上白芝麻和葱花即可出锅",
    "cookingTime": 30,
    "difficulty": "easy",
    "servings": 2,
    "tags": [
      "经典",
      "下饭",
      "新手友好"
    ],
